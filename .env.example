# Copie para .env na raiz do projeto (o .env NÃO deve ir para o Git).
# Credenciais sensíveis (PAT Azure, chave Google Gemini): prefira a tela Configurações —
# são gravadas criptografadas no banco, nunca retornadas pela API.

POSTGRES_USER=aderencia
POSTGRES_PASSWORD=aderencia
POSTGRES_DB=aderencia
DATABASE_URL=postgresql+psycopg2://aderencia:aderencia@db:5432/aderencia
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# Chave Fernet (obrigatória em produção). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Azure DevOps — apenas migração inicial (legado). Após subir a API uma vez, remova AZURE_DEVOPS_PAT
# daqui e mantenha o token só em Configurações. Não commite PAT em repositório.
AZURE_DEVOPS_URL=
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_FIELD_WORK_DATE=
AZURE_DEVOPS_FIELD_ACTIVITY=

# Chave Google Gemini: configure somente em Configurações > IA (não há variável de ambiente).
